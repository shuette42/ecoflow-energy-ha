# Probe output carries real serial numbers, user IDs and raw frames.
# Match files with any extension and whole output directories, not just .json.
probe_output_*
probe_output_*/

# Local mitmproxy/protocol captures
dumps/
*.mitm
mitm-flows*.dump
ecoflow-mqtt-decoded*.json
.venv-proto/

# Editor and tooling backups. A copy of a production module next to the module
# is invisible to `git status` when only a personal ~/.config/git/ignore covers
# it, and a fresh checkout without that config would stage it into this public
# repository on the next `git add -A`. Found 2026-09-04 in a review.
*.bak
*.orig
*.rej
